<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ModelDownloadWorker uses a foreground service so a 1.2 GB model
         download keeps running when the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- WorkManager (≤ 2.9.x) declares SystemForegroundService without a
             foregroundServiceType. API 34+ rejects startForeground() unless
             the service element advertises a superset of the runtime type,
             so we override here to keep the worker compatible everywhere
             without forcing consumers to bump WorkManager. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
    </application>
</manifest>
